-- internal/database/database.go --
package database

import salesorderflowEntity "code.example.dev/finance/ledger/v2/internal/domain/sales/orderflow/entity"

import (
	customSeeds "code.example.dev/finance/ledger/v2/internal/database/seeders"
	"github.com/goforj/wire"
	"gitlab.com/skyrix-lib/framework/database/dbcmd"
)

type UserModel struct{}

// Models keeps explicit user registrations.
func Models() dbcmd.Models {
	return dbcmd.Models{&UserModel{}, /* user model */
		&salesorderflowEntity.LineItem{},
	}
}
func Seeders(user *customSeeds.UserSeeder /* comma, in a comment */, currencyCodes *customSeeds.CurrencyCodesSeeder, taxCodes *customSeeds.TaxCodesSeeder) dbcmd.Seeders {
	return dbcmd.Seeders{user, /* user seeder */
		currencyCodes,
		taxCodes,
	}
}

var ProviderSet = wire.NewSet(Models, Seeders, customSeeds.NewUserSeeder,
	customSeeds.NewCurrencyCodesSeeder,
	customSeeds.NewTaxCodesSeeder,
)

