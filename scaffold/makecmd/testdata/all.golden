-- providers/commands.go --
// User console commands.
package providers

import commands "code.example.dev/finance/ledger/v2/internal/commands"

import (
	"code.example.dev/finance/ledger/v2/internal/config"
	"github.com/spf13/cobra"
	"gitlab.com/skyrix-lib/framework/cobra/console"
	"gitlab.com/skyrix-lib/framework/database/dbcmd"
	"gitlab.com/skyrix-lib/framework/logger"
)

type CommandDeps struct {
	Config *config.Config
	Logger logger.Interface
}

func Hello(deps *console.Graph[*CommandDeps]) *cobra.Command { return &cobra.Command{Use: "hello"} }
func ProvideConsoleCommands(app *console.Graph[*CommandDeps]) []*cobra.Command {
	return []*cobra.Command{Hello(app), /* keep command */
		commands.ReconcileAccounts(console.With(app, func(cmd *cobra.Command, args []string, deps *CommandDeps) error {
			return commands.RunReconcileAccounts(cmd, args, deps.Config, deps.Logger)
		})),
	}
}
func ProvideConsoleDatabaseCommands(database *console.Graph[*dbcmd.Deps]) []*cobra.Command {
	return []*cobra.Command{
		commands.ScanInvoices(console.With(database, func(cmd *cobra.Command, args []string, deps *dbcmd.Deps) error {
			return commands.RunScanInvoices(cmd, args, deps)
		})),
	}
}

-- providers/database.go --
package providers

import (
	customSeeds "code.example.dev/finance/ledger/v2/database/seeders"
	"github.com/goforj/wire"
	"gitlab.com/skyrix-lib/framework/database/dbcmd"
)

func Seeders(user *customSeeds.UserSeeder /* comma, in a comment */, currencyCodes *customSeeds.CurrencyCodesSeeder, taxCodes *customSeeds.TaxCodesSeeder) dbcmd.Seeders {
	return dbcmd.Seeders{user, /* user seeder */
		currencyCodes,
		taxCodes,
	}
}

var DatabaseProviderSet = wire.NewSet(Seeders, customSeeds.NewUserSeeder,
	customSeeds.NewCurrencyCodesSeeder,
	customSeeds.NewTaxCodesSeeder,
)

