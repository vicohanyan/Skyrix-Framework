package commands

import (
 "gitlab.com/skyrix-lib/framework/cobra/console"
 "github.com/spf13/cobra"
 "{{.Module}}/internal/config"
 "gitlab.com/skyrix-lib/framework/logger"
)

// {{.Type}} describes metadata; providers supplies its lazy runner.
func {{.Type}}(run console.Handler) *cobra.Command {
 return &cobra.Command{
  Use: {{printf "%q" .Use}}, Short: "Implement {{.Type}}", Args: cobra.NoArgs,
  RunE: run,
 }
}

// Run{{.Type}} implements the command with dependencies supplied on execution.
func Run{{.Type}}(cmd *cobra.Command, args []string, cfg *config.Config, log logger.Interface) error {
 return nil
}
